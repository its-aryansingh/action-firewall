# ---- LLM ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_MAX_AUDIO_BYTES=6000000

# ---- Pinecone (agent-readable catalog) ----
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=razorpay-catalog
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Razorpay Remote MCP ----
# Generate with:  printf '%s' "$RAZORPAY_KEY_ID:$RAZORPAY_KEY_SECRET" | base64
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp
RAZORPAY_MCP_TOKEN=

# ---- Langfuse (audit trail) ----
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- App ----
DB_PATH=./mandates.db
DEMO_MODE=true
PAYMENT_PROVIDER=simulated
CATALOG_RETRIEVAL_MODE=keyword
ENVELOPE_DRAFTING_MODE=replay
FAULT_INJECTION_ENABLED=true
# Required when DEMO_MODE=false. Signs application receipts; never expose it to the browser.
ACTION_RECEIPT_SECRET=replace-with-at-least-32-random-bytes
