{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m compileall *)",
      "Bash(python scripts/demo.py)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm audit *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(python -m compileall *)",
      "PowerShell(python scripts/demo.py)",
      "PowerShell(npm ci)",
      "PowerShell(npm run build)",
      "PowerShell(npm audit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.db)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)"
    ]
  }
}
